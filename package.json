{
  "name": "beyond-green",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "investigate": "node --env-file-if-exists=.env scripts/investigate.ts",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.ts",
    "benchmark:linkding:suite": "python3 benchmarks/linkding/suite.py",
    "weave:check": "node --env-file-if-exists=.env scripts/check-weave.ts",
    "models:check": "node --env-file-if-exists=.env scripts/check-models.ts",
    "benchmark:linkding:setup": "python3 benchmarks/linkding/run.py --setup",
    "benchmark:linkding": "python3 benchmarks/linkding/run.py",
    "benchmark:linkding:mutation": "python3 benchmarks/linkding/experiment.py",
    "benchmark:linkding:show": "python3 benchmarks/linkding/show_capture.py"
  },
  "dependencies": {
    "weave": "^0.16.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
